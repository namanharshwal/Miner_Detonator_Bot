    <origin rpy="0 0 0" xyz="0.071755 0 -0.0028894"/>
    <parent link="base_link"/>
    <child link="fc_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="15"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="fcw_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
