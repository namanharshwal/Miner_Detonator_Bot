    </material>
  </gazebo>
  <!-- ================= 4D LIDAR SENSOR ON TOP ================= -->
  <!-- 4D LiDAR Riser / Housing -->
  <link name="lidar4d_mount_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://army_mine_amr/meshes/lidar4d.STL"/>
      </geometry>
      <material name="tactical_dark"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
      <geometry>
        <cylinder length="0.10" radius="0.046"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
      <mass value="0.25"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="lidar4d_mount_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.168"/>
    <parent link="base_link"/>
    <child link="lidar4d_mount_link"/>
  </joint>
  <!-- Optical center of 4D LiDAR (emitter/receiver center) -->
  <link name="lidar4d_link"/>
  <joint name="lidar4d_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.076"/>
    <parent link="lidar4d_mount_link"/>
    <child link="lidar4d_link"/>
  </joint>
  <!-- Gazebo Sim 4D GPU LiDAR Sensor -->
  <gazebo reference="lidar4d_link">
    <sensor name="lidar4d" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <visualize>false</visualize>
      <topic>/scan</topic>
      <gz_frame_id>lidar4d_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.008</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- ================= IMU SENSOR ================= -->
  <link name="imu_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
