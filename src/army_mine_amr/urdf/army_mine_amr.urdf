    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.007"/>
      <geometry>
        <cylinder length="0.045" radius="0.0525"/>
      </geometry>
    </collision>
  </link>
  <joint name="lw_joint" type="continuous">
    <origin rpy="-1.5708 0 0" xyz="0 0.11086 0.018076"/>
    <parent link="base_link"/>
    <child link="lw_link"/>
    <axis xyz="0 0 1"/>
