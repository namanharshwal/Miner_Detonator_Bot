        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.15</near>
          <far>15.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.15</near>
            <far>15.0</far>
          </clip>
        </depth_camera>
        <noise>
