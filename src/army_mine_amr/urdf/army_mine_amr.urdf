      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>
  <!-- ================= NIPUN ANTI-PERSONNEL MINE CARRIER PAYLOAD ================= -->
  <!-- Requirements 2, 6, 10, 15 from Downloads/1.docx: 10cm coaster-sized NIPUN minelet carrier -->
  <link name="mine_probe_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.04 0 0.142"/>
      <geometry>
        <cylinder length="0.025" radius="0.05"/>
      </geometry>
      <material name="army_camo_green"/>
