<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  ARMY BORDER UNEVEN TERRAIN AMR (Autonomous Mobile Robot)
  Derived from: Swarmy Mobile Robot (Hardware Proven Platform)
  Enhanced for: Uneven Ground Traversability, 4D LiDAR SLAM, & Mine Defusal
  ============================================================================
-->
<robot name="army_mine_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= MATERIALS ================= -->
  <material name="army_camo_green">
    <color rgba="0.32 0.40 0.28 1.0"/>
  </material>
  <material name="tactical_dark">
    <color rgba="0.15 0.16 0.17 1.0"/>
  </material>
  <material name="wheel_rubber">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="sensor_aluminum">
    <color rgba="0.45 0.47 0.50 1.0"/>
  </material>
  <material name="lidar_optical_dome">
    <color rgba="0.05 0.12 0.22 0.95"/>
  </material>
  <material name="laser_emitter_red">
    <color rgba="0.95 0.15 0.15 1.0"/>
  </material>
  <material name="probe_carbon">
    <color rgba="0.20 0.22 0.24 1.0"/>
  </material>

  <!-- ================= BASE FOOTPRINT ================= -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.033" rpy="0 0 0"/>
  </joint>

  <!-- ================= BASE LINK (CHASSIS) ================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.002 -0.0001 0.045" rpy="0 0 0"/>
      <mass value="3.85"/>
      <inertia ixx="0.0145" ixy="0.00001" ixz="-0.00001"
               iyy="0.0182" iyz="-0.00001" izz="0.0265"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://army_mine_amr/meshes/base_link.STL"/>
      </geometry>
      <material name="army_camo_green"/>
    </visual>
    <!-- Multi-tier collision geometry for rugged uneven ground clearance -->
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.18 0.13"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.16 0.03"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <material>
      <ambient>0.32 0.40 0.28 1</ambient>
      <diffuse>0.42 0.52 0.38 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </material>
  </gazebo>

  <!-- ================= LEFT WHEEL ================= -->
  <link name="lw_link">
    <inertial>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00035" ixy="0" ixz="0"
               iyy="0.00035" iyz="0" izz="0.00058"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://army_mine_amr/meshes/lw_link.STL"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <!-- Cylindrical high-traction all-terrain tire collision -->
    <collision>
      <origin xyz="0 0 -0.007" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.051" length="0.045"/>
      </geometry>
    </collision>
  </link>

  <joint name="lw_joint" type="continuous">
    <origin xyz="0 0.11086 0.018076" rpy="-1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="lw_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="25" velocity="20"/>
    <dynamics damping="0.15" friction="0.1"/>
  </joint>

  <gazebo reference="lw_link">
    <mu1>1.8</mu1>
    <mu2>1.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.002</minDepth>
    <material>
      <ambient>0.1 0.1 0.1 1</ambient>
      <diffuse>0.15 0.15 0.15 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </material>
  </gazebo>

  <!-- ================= RIGHT WHEEL ================= -->
  <link name="rw_link">
    <inertial>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00035" ixy="0" ixz="0"
               iyy="0.00035" iyz="0" izz="0.00058"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://army_mine_amr/meshes/rw_link.STL"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <!-- Cylindrical high-traction all-terrain tire collision -->
    <collision>
      <origin xyz="0 0 0.007" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.051" length="0.045"/>
      </geometry>
    </collision>
  </link>

  <joint name="rw_joint" type="continuous">
    <origin xyz="0 -0.11086 0.018076" rpy="-1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="rw_link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="25" velocity="20"/>
    <dynamics damping="0.15" friction="0.1"/>
  </joint>

  <gazebo reference="rw_link">
    <mu1>1.8</mu1>
    <mu2>1.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.002</minDepth>
    <material>
      <ambient>0.1 0.1 0.1 1</ambient>
      <diffuse>0.15 0.15 0.15 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </material>
  </gazebo>

  <!-- ================= FRONT CASTER ASSEMBLY ================= -->
  <link name="fc_link">
    <inertial>
      <origin xyz="0.0045 -0.0003 -0.0044" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000005" ixy="0" ixz="0"
               iyy="0.000005" iyz="0" izz="0.000008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://army_mine_amr/meshes/fc_link.STL"/>
      </geometry>
      <material name="tactical_dark"/>
    </visual>
  </link>

  <joint name="fc_joint" type="continuous">
    <origin xyz="0.071755 0 -0.0028894" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="fc_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="15"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="fcw_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.000005" ixy="0" ixz="0"
               iyy="0.000005" iyz="0" izz="0.000008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://army_mine_amr/meshes/fcw_link.STL"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <!-- Smooth spherical collision contact: prevents catching on dirt ridges & crater edges -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.013"/>
      </geometry>
    </collision>
  </link>

  <joint name="fcw_joint" type="continuous">
    <origin xyz="0.012 0 -0.017111" rpy="-1.5708 0 0"/>
    <parent link="fc_link"/>
    <child link="fcw_link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="10" velocity="15"/>
    <dynamics damping="0.02" friction="0.02"/>
  </joint>

  <gazebo reference="fcw_link">
    <mu1>0.08</mu1>
    <mu2>0.08</mu2>
    <material>
      <ambient>0.15 0.15 0.15 1</ambient>
      <diffuse>0.2 0.2 0.2 1</diffuse>
    </material>
  </gazebo>

  <!-- ================= REAR CASTER ASSEMBLY ================= -->
  <link name="rc_link">
    <inertial>
      <origin xyz="-0.0045 0 -0.0044" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000005" ixy="0" ixz="0"
               iyy="0.000005" iyz="0" izz="0.000008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://army_mine_amr/meshes/rc_link.STL"/>
      </geometry>
      <material name="tactical_dark"/>
    </visual>
  </link>

  <joint name="rc_joint" type="continuous">
    <origin xyz="-0.071755 0 -0.0028894" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rc_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="15"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="rcw_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.000005" ixy="0" ixz="0"
               iyy="0.000005" iyz="0" izz="0.000008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://army_mine_amr/meshes/rcw_link.STL"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <!-- Smooth spherical collision contact -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.013"/>
      </geometry>
    </collision>
  </link>

  <joint name="rcw_joint" type="continuous">
    <origin xyz="0.012 0 -0.017111" rpy="-1.5708 0 0"/>
    <parent link="rc_link"/>
    <child link="rcw_link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="10" velocity="15"/>
    <dynamics damping="0.02" friction="0.02"/>
  </joint>

  <gazebo reference="rcw_link">
    <mu1>0.08</mu1>
    <mu2>0.08</mu2>
    <material>
      <ambient>0.15 0.15 0.15 1</ambient>
      <diffuse>0.2 0.2 0.2 1</diffuse>
    </material>
  </gazebo>

  <!-- ================= 4D LIDAR SENSOR ON TOP ================= -->
  <!-- 4D LiDAR Riser / Housing -->
  <link name="lidar4d_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://army_mine_amr/meshes/lidar4d.STL"/>
      </geometry>
      <material name="tactical_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.046" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.0002" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="lidar4d_mount_joint" type="fixed">
    <origin xyz="0.0 0.0 0.168" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar4d_mount_link"/>
  </joint>

  <!-- Optical center of 4D LiDAR (emitter/receiver center) -->
  <link name="lidar4d_link"/>

  <joint name="lidar4d_joint" type="fixed">
    <origin xyz="0.0 0.0 0.076" rpy="0 0 0"/>
    <parent link="lidar4d_mount_link"/>
    <child link="lidar4d_link"/>
  </joint>

  <!-- Gazebo Sim 4D GPU LiDAR Sensor -->
  <gazebo reference="lidar4d_link">
    <sensor name="lidar4d" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <visualize>false</visualize>
      <topic>/scan</topic>
      <gz_frame_id>lidar4d_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.008</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ================= IMU SENSOR ================= -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ================= MINE DETECTION & DEFUSAL PROBE ================= -->
  <link name="mine_probe_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://army_mine_amr/meshes/mine_probe.STL"/>
      </geometry>
      <material name="probe_carbon"/>
    </visual>
    <collision>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="mine_probe_joint" type="fixed">
    <origin xyz="0.100 0.0 0.035" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="mine_probe_link"/>
  </joint>

  <!-- ================= GAZEBO SIM SIMULATION PLUGINS ================= -->
  <gazebo>
    <!-- Differential Drive Navigation on Uneven Surface -->
    <plugin filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>lw_joint</left_joint>
      <right_joint>rw_joint</right_joint>
      <wheel_separation>0.22172</wheel_separation>
      <wheel_radius>0.051</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <min_linear_acceleration>-3.0</min_linear_acceleration>
      <max_angular_acceleration>4.5</max_angular_acceleration>
      <min_angular_acceleration>-4.5</min_angular_acceleration>
      <max_linear_velocity>1.5</max_linear_velocity>
      <min_linear_velocity>-1.5</min_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity>
      <min_angular_velocity>-3.0</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <!-- Joint State Publisher -->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>lw_joint</joint_name>
      <joint_name>rw_joint</joint_name>
      <joint_name>fc_joint</joint_name>
      <joint_name>fcw_joint</joint_name>
      <joint_name>rc_joint</joint_name>
      <joint_name>rcw_joint</joint_name>
    </plugin>

    <!-- Sensor Rendering Plugin -->
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- IMU System Plugin -->
    <plugin filename="libignition-gazebo-imu-system.so"
            name="ignition::gazebo::systems::Imu">
    </plugin>
  </gazebo>

</robot>
