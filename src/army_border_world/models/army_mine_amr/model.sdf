    <!-- ================= 4-WHEEL ALL-TERRAIN SKID-STEER DRIVE ================= -->
    <!-- Front Left Wheel -->
    <joint name='fl_wheel_joint' type='revolute'>
      <pose relative_to='base_footprint'>0.075 0.11086 0.051076 -1.5708 0 0</pose>
      <parent>base_footprint</parent>
      <child>fl_wheel_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <effort>50</effort>
          <velocity>20</velocity>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <damping>0.15</damping>
          <friction>0.10</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='fl_wheel_link'>
      <pose relative_to='fl_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.005 0 0 0</pose>
        <mass>0.45</mass>
