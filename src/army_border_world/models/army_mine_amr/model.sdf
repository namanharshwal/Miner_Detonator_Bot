      </sensor>
      <!-- Tactical Intel RealSense D435 RGB-D Depth Camera -->
      <sensor name='depth_camera' type='rgbd_camera'>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <topic>/camera</topic>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
