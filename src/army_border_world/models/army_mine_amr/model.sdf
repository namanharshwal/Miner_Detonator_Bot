              <far>15.0</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
        <pose>0.133 0 0.193 0 0 0</pose>
        <gz_frame_id>camera_link</gz_frame_id>
      </sensor>
