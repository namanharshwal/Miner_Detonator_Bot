    </frame>
    <frame name='lidar4d_mount_joint' attached_to='base_link'>
      <pose>0 0 0.16800000000000001 0 0 0</pose>
    </frame>
    <frame name='lidar4d_mount_link' attached_to='lidar4d_mount_joint'>
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame name='mine_probe_joint' attached_to='base_link'>
      <pose>0.10000000000000001 0 0.035000000000000003 0 0 0</pose>
    </frame>
    <frame name='mine_probe_link' attached_to='mine_probe_joint'>
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <!-- Intel RealSense D435 Depth Camera Frames -->
