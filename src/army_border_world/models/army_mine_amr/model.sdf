    <!-- 4-Wheel Skid-Steer Differential Drive Plugin -->
    <plugin name='ignition::gazebo::systems::DiffDrive' filename='libignition-gazebo-diff-drive-system.so'>
      <left_joint>fl_wheel_joint</left_joint>
      <left_joint>rl_wheel_joint</left_joint>
      <right_joint>fr_wheel_joint</right_joint>
      <right_joint>rr_wheel_joint</right_joint>
      <wheel_separation>0.22172</wheel_separation>
      <wheel_radius>0.0525</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_wheel_torque>60.0</max_wheel_torque>
      <max_wheel_acceleration>15.0</max_wheel_acceleration>
      <max_linear_acceleration>5.0</max_linear_acceleration>
      <min_linear_acceleration>-5.0</min_linear_acceleration>
      <max_angular_acceleration>6.0</max_angular_acceleration>
      <min_angular_acceleration>-6.0</min_angular_acceleration>
      <max_linear_velocity>2.0</max_linear_velocity>
      <min_linear_velocity>-2.0</min_linear_velocity>
      <max_angular_velocity>3.5</max_angular_velocity>
      <min_angular_velocity>-3.5</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <!-- Joint State Publisher for 4 Wheels -->
    <plugin name='ignition::gazebo::systems::JointStatePublisher' filename='libignition-gazebo-joint-state-publisher-system.so'>
      <topic>/joint_states</topic>
      <joint_name>fl_wheel_joint</joint_name>
      <joint_name>fr_wheel_joint</joint_name>
      <joint_name>rl_wheel_joint</joint_name>
      <joint_name>rr_wheel_joint</joint_name>
    </plugin>
    <plugin name='ignition::gazebo::systems::Sensors' filename='libignition-gazebo-sensors-system.so'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='ignition::gazebo::systems::Imu' filename='libignition-gazebo-imu-system.so'/>
    <frame name='imu_joint' attached_to='base_link'>
      <pose>0 0 0.050000000000000003 0 0 0</pose>
    </frame>
    <frame name='imu_link' attached_to='imu_joint'>
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame name='lidar4d_joint' attached_to='lidar4d_mount_link'>
